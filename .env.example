# ========================
# Linkedon Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ========================

# App
NODE_ENV=development
PORT=3001

# Database
MONGODB_URI=mongodb://localhost:27017/linkedon

# Cache / Queues
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (for API keys, sensitive data)
ENCRYPTION_KEY=your-32-character-encryption-key!!

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chrome Extension
EXTENSION_CLIENT_ID=your-extension-client-id

# AWS S3 / S3-compatible storage (for CSV exports)
S3_BUCKET=linkedon-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_ENDPOINT=https://s3.amazonaws.com

# Email (Resend / SendGrid / SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@linkedon.io

# Admin
ADMIN_EMAIL=admin@linkedon.io

# Feature flags
ENABLE_REAL_PROVIDERS=false
ENABLE_BULK_ENRICHMENT=true
ENABLE_API_ACCESS=true
ENABLE_WEBHOOKS=true
